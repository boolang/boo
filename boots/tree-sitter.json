{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "boots",
      "camelcase": "Boots",
      "title": "Boots",
      "scope": "source.boots",
      "file-types": [
        "boo"
      ],
      "injection-regex": "^boots$",
      "class-name": "TreeSitterBoots"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "description": "boo tree sitter grammar",
    "authors": [
      {
        "name": "a"
      }
    ],
    "links": {
